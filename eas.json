{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": { 
        "EXPO_PUBLIC_GATEWAY_URL": "https://wellnest-monolithic.onrender.com" 
      }
    },
    "production": {}
  }
}

